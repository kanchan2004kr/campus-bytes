# ─────────────────────────────────────────────────────────────
# Campus Bytes — environment variables (copy to .env, never commit .env)
# ─────────────────────────────────────────────────────────────

# ── Web (apps/web) ──
# Leave NEXT_PUBLIC_API_URL BLANK to run the UI on in-memory demo data.
# Set it to the API base to connect the real backend (note the /api/v1 suffix).
NEXT_PUBLIC_API_URL=
# e.g. NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# ── API (apps/api) ──
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL. DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is the direct (non-pooled) connection used for migrations —
# required by hosted Postgres like Neon/Supabase; can equal DATABASE_URL locally.
DATABASE_URL=postgresql://user:password@localhost:5432/campus_bytes?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/campus_bytes?schema=public

# Default tenant (single-campus MVP) — must match the seed.
DEFAULT_TENANT_SUBDOMAIN=nims

# Auth / JWT — generate strong random secrets in production.
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis (Upstash) — used for caching/queues/WS scale-out (optional in dev).
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Resend — REQUIRED for real student email OTP.
#   - In development, if RESEND_API_KEY is empty, the OTP prints to the API console.
#   - In production (NODE_ENV=production) a missing key makes OTP requests fail (never fake-send).
#   - RESEND_FROM_EMAIL must use a Resend-VERIFIED domain, OR the shared sender
#     "onboarding@resend.dev" (which can only email your own Resend account address).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Campus Bytes <onboarding@resend.dev>

# Razorpay (server-side) — wired in Phase 10, not required for Phase 7.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Cloudinary (menu images) — optional in Phase 7.
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret
